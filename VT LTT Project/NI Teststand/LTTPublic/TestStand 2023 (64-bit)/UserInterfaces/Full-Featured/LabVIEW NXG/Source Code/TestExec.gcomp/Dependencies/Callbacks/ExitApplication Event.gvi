			<GenerateUserEvent Bounds="1030 350 40 40" Id="64" Label="65" />
			<NodeLabel AttachedTo="64" Bounds="1030 329 154 18" Id="65" IsReadOnly="True" Visible="False" xmlns="http://www.ni.com/PlatformFramework">
				<p.Text>Generate User Event</p.Text>
			</NodeLabel>
			<Comment Bounds="445 140 590 82" Id="66" xmlns="http://www.ni.com/MocCommon">
				<p.Text>"The Application Manager generates the ExitApplication event when TestStand is finished shutting down.\nThis event signals that the user interface can stop. Additionally, the user interface can release\nany references it has to TestStand objects, including menu commands.\n \n\nNote: This VI is marked to be reentrant since it is an ActiveX event callback VI."</p.Text>
			</Comment>
			<Comment Bounds="545 485 260 28" Id="67" xmlns="http://www.ni.com/MocCommon">
				<p.Text>"Fire Quit Application Event so that the Main\nEvent Loop in Top-Level VI.vi can stop."</p.Text>
			</Comment>
			<Wire Id="75" Joints="N(53:Out)|(984,355) h(19) v(10) N(64:event data)|(1030,365)" xmlns="http://www.ni.com/PlatformFramework" />
