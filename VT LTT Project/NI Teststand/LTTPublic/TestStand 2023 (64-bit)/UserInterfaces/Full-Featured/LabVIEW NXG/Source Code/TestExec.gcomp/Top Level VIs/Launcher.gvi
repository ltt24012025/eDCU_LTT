			<CloseReference Bounds="1515 350 40 40" Id="42" />
			<Comment Bounds="1110 155 325 160" Id="44" SizeToText="False" xmlns="http://www.ni.com/MocCommon">
				<p.Text>"This VI is the splash screen and launcher for the full-featured\nuser interface. It performs the following operations:\n\n1. set the TestStand environment based on the command line arguments\n2. Opens reference to itself to pass to Full UI - Top-Level VI.vi.\nThat VI will close the panel of this VI after it shows its own panel.\n3. Opens and runs Full UI - Top-Level VI.vi. This is done\ndynamically to improve the launch time of the application.\n4. Waits until Full UI - Top-Level VI.vi completes and closes the\nreference to that VI.\n5. If the VI is not running in a built application, reopens its panel.\n6. If the VI is running in a built application, exits the application."</p.Text>
			</Comment>
			<Wire Id="47" Joints="N(42:error out)|(1555,385) N(38:35)|(1571,385)" xmlns="http://www.ni.com/PlatformFramework" />
			<Wire Id="48" Joints="N(34:error out)|(1485,385) N(42:error in)|(1515,385)" xmlns="http://www.ni.com/PlatformFramework" />
