					<Comment Bounds="585 1010 440 15" Id="494" xmlns="http://www.ni.com/MocCommon">
						<p.Text>Error occurred in the launcher. Report the error and shut down immediately</p.Text>
					</Comment>
					<Wire Id="642" Joints="N(492:R3)|(845,970) h(961) v(-105) N(66:64)|(1811,865)" xmlns="http://www.ni.com/PlatformFramework" />
					<Wire Id="643" Joints="N(65:64)|(4,725) h(5) v(245) N(492:L3)|(805,970)" xmlns="http://www.ni.com/PlatformFramework" />
